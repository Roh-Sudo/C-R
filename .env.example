DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance
APP_URL=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
CORS_ORIGIN=http://localhost:5173
PORT=8787
PERSISTENCE=postgres
PILOT_MODE=false

# development | test | production. Production startup fails fast if
# DATABASE_URL, APP_URL (must be https://), or AUTH_SECRET are missing, or if
# CORS_ORIGIN is a wildcard. See apps/api/src/env.ts.
NODE_ENV=development

# HMAC secret for the local/test billing provider webhook (packages/billing-core).
# Replace with a real payment provider's webhook signing secret once one is integrated.
LOCAL_BILLING_WEBHOOK_SECRET=replace-with-a-random-secret
# Shared secret for the internal admin commercial dashboard (x-admin-token header).
ADMIN_TOKEN=replace-with-a-random-secret

# Explicit local development / test fallback only. Production and PILOT_MODE=true
# require PostgreSQL and never silently use this adapter.
PLATFORM_DATA_FILE=.data/platform.json

